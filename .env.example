# =============================================================================
# Quarkus DDD — Environment Variables Template
# Copie este arquivo para .env e preencha com os valores reais.
# Este arquivo (.env.example) é seguro para commitar no git.
# =============================================================================

# ===== Application =====
APP_PORT=8081
APP_NAME=quarkus-ddd

# ===== PostgreSQL — Aplicação =====
DB_HOST=postgres
DB_PORT=5432
DB_NAME=olist
DB_USERNAME=
DB_PASSWORD=

# ===== PostgreSQL — Keycloak =====
KC_DB_HOST=postgres-keycloak
KC_DB_PORT=5432
KC_DB_NAME=keycloak
KC_DB_USERNAME=
KC_DB_PASSWORD=

# ===== Keycloak =====
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=spring-webflux
KEYCLOAK_CLIENT_ID=spring-webflux-client
KEYCLOAK_CLIENT_SECRET=
KC_HOSTNAME=localhost

# ===== HashiCorp Vault =====
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/olist-app

# ===== JWT =====
JWT_SECRET=

# ===== Logging =====
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
