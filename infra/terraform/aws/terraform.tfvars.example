region             = "us-east-1"
cluster_name       = "olist-eks"
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_count         = 2
node_max_count     = 5
db_instance_class  = "db.t3.micro"
db_storage_gb      = 20
# db_password      = definir via TF_VAR_db_password ou AWS Secrets Manager
