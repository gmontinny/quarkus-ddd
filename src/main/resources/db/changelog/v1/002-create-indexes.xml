<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-indexes" author="olist">
        <createIndex tableName="customers" indexName="idx_customers_unique_id">
            <column name="customer_unique_id"/>
        </createIndex>
        <createIndex tableName="customers" indexName="idx_customers_state">
            <column name="customer_state"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_customer_id">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_status">
            <column name="order_status"/>
        </createIndex>
        <createIndex tableName="order_items" indexName="idx_order_items_product_id">
            <column name="product_id"/>
        </createIndex>
        <createIndex tableName="order_items" indexName="idx_order_items_seller_id">
            <column name="seller_id"/>
        </createIndex>
        <createIndex tableName="geolocation" indexName="idx_geolocation_zip">
            <column name="geolocation_zip_code_prefix"/>
        </createIndex>
        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_username">
            <column name="username"/>
        </createIndex>
        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_token">
            <column name="token"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
